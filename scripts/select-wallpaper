#!/usr/bin/env bash
set -euo pipefail

export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"

wallpaper_dir="${WALLPAPER_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/tqq-niri-rice/wallpapers}"
state_home="${XDG_STATE_HOME:-$HOME/.local/state}/tqq-niri-rice"
state_file="$state_home/current-wallpaper"
config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
matugen_config="$config_home/matugen/config.toml"
picker="${WALLPAPER_PICKER:-$HOME/.local/bin/wallpaper-picker.py}"
wait_for_components=0

notify() {
    command -v notify-send >/dev/null 2>&1 && notify-send "TQQ Niri rice" "$1" || true
}

set_wallpaper() {
    local image="$1"
    [[ -r "$image" ]] || { notify "Can't read wallpaper: $image"; return 1; }

    if command -v awww >/dev/null 2>&1; then
        if ! awww query >/dev/null 2>&1 && command -v awww-daemon >/dev/null 2>&1; then
            nohup awww-daemon >/dev/null 2>&1 </dev/null &
            local attempt
            for attempt in {1..30}; do
                awww query >/dev/null 2>&1 && break
                sleep 0.2
            done
        fi
        if awww query >/dev/null 2>&1 && awww img --transition-type fade --transition-duration 0.7 -- "$image"; then
            :
        elif command -v swaybg >/dev/null 2>&1; then
            pkill -x swaybg >/dev/null 2>&1 || true
            nohup swaybg -i "$image" -m fill >/dev/null 2>&1 </dev/null &
        else
            notify "awww is unavailable and swaybg is not installed."
            return 1
        fi
    elif command -v swaybg >/dev/null 2>&1; then
        pkill -x swaybg >/dev/null 2>&1 || true
        nohup swaybg -i "$image" -m fill >/dev/null 2>&1 </dev/null &
    else
        notify "Install awww or swaybg to display wallpapers."
        return 1
    fi

    mkdir -p "$state_home"
    printf '%s\n' "$image" > "$state_file"

    if ! command -v matugen >/dev/null 2>&1; then
        notify "Wallpaper changed, but Matugen is missing; colors were not updated."
        return 1
    fi
    if [[ ! -r "$matugen_config" ]]; then
        notify "Matugen config not found: $matugen_config"
        return 1
    fi
    matugen_log="$state_home/matugen.log"
    if ! matugen -c "$matugen_config" image "$image" -m dark --source-color-index 0 >"$matugen_log" 2>&1; then
        notify "Wallpaper changed, but Matugen failed. Details: $matugen_log"
        return 1
    fi

    if [[ ! -s "$config_home/waybar/colors.css" \
        || ! -s "$config_home/swaync/colors.css" \
        || ! -s "$config_home/fuzzel/colors.ini" ]] \
        || grep -q 'Starter palette' \
            "$config_home/waybar/colors.css" \
            "$config_home/swaync/colors.css" \
            "$config_home/fuzzel/colors.ini"; then
        notify "Matugen did not replace the starter colors. Check $matugen_log and $matugen_config."
        return 1
    fi

    if [[ -f "$config_home/fetch/config" ]]; then
        python3 - "$config_home/waybar/colors.css" "$config_home/fetch/config" <<'PYFETCH'
from pathlib import Path
import re
import sys

palette = Path(sys.argv[1]).read_text()
fetch_config = Path(sys.argv[2])
match = re.search(r"(?m)^@define-color primary #([0-9a-fA-F]{6});", palette)
if not match:
    raise SystemExit("Matugen's Waybar palette has no primary hex color")

red, green, blue = (int(match.group(1)[i:i + 2], 16) for i in (0, 2, 4))
cube = [0, 95, 135, 175, 215, 255]
colors = [
    (16 + 36 * r + 6 * g + b, (rv, gv, bv))
    for r, rv in enumerate(cube)
    for g, gv in enumerate(cube)
    for b, bv in enumerate(cube)
]
colors.extend((232 + n, (8 + 10 * n,) * 3) for n in range(24))
ansi = min(
    colors,
    key=lambda item: sum(
        (channel - value) ** 2
        for channel, value in zip((red, green, blue), item[1])
    ),
)[0]

text = fetch_config.read_text()
setting = f"label_color={ansi}"
if re.search(r"(?m)^label_color=.*$", text):
    text = re.sub(r"(?m)^label_color=.*$", setting, text, count=1)
else:
    text = text.rstrip() + "\n" + setting + "\n"
fetch_config.write_text(text)
PYFETCH
    fi

    if ((wait_for_components)); then
        local attempt
        for attempt in {1..30}; do
            pgrep -x waybar >/dev/null 2>&1 && break
            sleep 0.1
        done
    fi
    pkill -SIGUSR2 -x waybar >/dev/null 2>&1 || true
    if command -v swaync-client >/dev/null 2>&1; then
        if ((wait_for_components)); then
            local attempt
            for attempt in {1..30}; do
                swaync-client -rs >/dev/null 2>&1 && break
                sleep 0.1
            done
        else
            swaync-client -rs >/dev/null 2>&1 || true
        fi
    fi
    notify "Wallpaper and desktop palette updated."
}

case "${1:-pick}" in
    --restore|restore)
        if [[ -r "$state_file" ]]; then
            IFS= read -r saved_image < "$state_file" || true
            wait_for_components=1
            [[ -n "${saved_image:-}" ]] && set_wallpaper "$saved_image"
        fi
        exit 0
        ;;
    --set|set)
        [[ $# -ge 2 ]] || { echo "Usage: $0 --set IMAGE" >&2; exit 2; }
        set_wallpaper "$2"
        exit
        ;;
    pick) ;;
    *) echo "Usage: $0 [pick|--restore|--set IMAGE]" >&2; exit 2 ;;
esac

for required in matugen python3; do
    if ! command -v "$required" >/dev/null 2>&1; then
        notify "Missing required command: $required"
        exit 1
    fi
done

if [[ ! -d "$wallpaper_dir" ]]; then
    notify "Wallpaper folder not found: $wallpaper_dir"
    exit 1
fi

mapfile -d '' wallpapers < <(
    find "$wallpaper_dir" -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) -print0 | sort -z
)

if ((${#wallpapers[@]} == 0)); then
    notify "No images found in $wallpaper_dir"
    exit 1
fi

if [[ ! -x "$picker" ]]; then
    notify "Wallpaper preview picker not found: $picker"
    exit 1
fi
selected="$(python3 "$picker" "$wallpaper_dir" "$state_file" || true)"
[[ -n "$selected" ]] || exit 0
set_wallpaper "$selected"
