#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
CHECK="$ROOT/scripts/check-dependencies"
export PATH="$HOME/.local/bin:$PATH"

if "$CHECK"; then
    echo "Required TQQ rice dependencies are already installed."
    exit 0
fi

if [[ ! -r /etc/os-release ]]; then
    echo "Cannot identify this Linux distribution. Install the packages listed by $CHECK manually." >&2
    exit 1
fi
. /etc/os-release

run_privileged() {
    if ((EUID == 0)); then
        "$@"
    elif command -v sudo >/dev/null 2>&1; then
        sudo "$@"
    else
        echo "Install sudo or run this script as root to install system packages." >&2
        return 1
    fi
}

install_matugen() {
    if command -v matugen >/dev/null 2>&1; then
        return 0
    fi

    if [[ "$(uname -m)" == x86_64 ]]; then
        local url="https://github.com/InioX/matugen/releases/download/v4.2.0/matugen-4.2.0-x86_64.tar.gz"
        local expected_sha="a2e3b50e49ed6439999ba3c252ed04fabd98ee4e9d12e5e5dff2e66370569751"
        local temp_dir binary
        if ! command -v curl >/dev/null 2>&1 || ! command -v sha256sum >/dev/null 2>&1; then
            echo "Matugen's x86_64 release needs curl and sha256sum." >&2
            return 1
        fi
        temp_dir="$(mktemp -d)"
        if ! curl --fail --location --silent --show-error "$url" --output "$temp_dir/matugen.tar.gz"; then
            rm -rf -- "$temp_dir"
            return 1
        fi
        if ! printf '%s  %s\n' "$expected_sha" "$temp_dir/matugen.tar.gz" | sha256sum --check --status; then
            echo "Matugen release checksum did not match; refusing to install it." >&2
            rm -rf -- "$temp_dir"
            return 1
        fi
        if ! tar -xzf "$temp_dir/matugen.tar.gz" -C "$temp_dir"; then
            rm -rf -- "$temp_dir"
            return 1
        fi
        binary="$(find "$temp_dir" -type f -name matugen -print -quit)"
        if [[ -z "$binary" ]]; then
            echo "Matugen executable was not found in the release archive." >&2
            rm -rf -- "$temp_dir"
            return 1
        fi
        install -D -m 0755 "$binary" "$HOME/.local/bin/matugen"
        rm -rf -- "$temp_dir"
        return 0
    fi

    if ! command -v cargo >/dev/null 2>&1 || ! command -v rustc >/dev/null 2>&1; then
        echo "Matugen is not packaged for this release. Install Cargo and Rust 1.88+ or use a prebuilt release from https://github.com/InioX/matugen/releases." >&2
        return 1
    fi
    rust_version="$(rustc --version | awk '{print $2}')"
    if [[ "$(printf '%s\n' 1.88 "$rust_version" | sort -V | head -n1)" != "1.88" ]]; then
        echo "Matugen v4.2.0 needs Rust 1.88 or newer; this system has $rust_version. Install a newer Rust toolchain before building Matugen." >&2
        return 1
    fi
    cargo install --locked --root "$HOME/.local" matugen
}

case "${ID:-}" in
    debian|ubuntu|linuxmint|pop)
        run_privileged apt-get update
        packages=(waybar sway-notification-center fuzzel rofi swaybg fonts-font-awesome fonts-jetbrains-mono hicolor-icon-theme python3)
        if ! command -v wpctl >/dev/null 2>&1; then
            packages+=(pipewire-bin wireplumber)
        fi
        if ! command -v matugen >/dev/null 2>&1; then
            if apt-cache show matugen >/dev/null 2>&1; then
                packages+=(matugen)
            elif [[ "$(uname -m)" == x86_64 ]]; then
                packages+=(curl)
            else
                packages+=(cargo build-essential)
            fi
        fi
        run_privileged apt-get install "${packages[@]}"
        install_matugen
        ;;
    arch|endeavouros|manjaro|cachyos)
        packages=(waybar swaync fuzzel rofi-wayland swaybg ttf-font-awesome ttf-jetbrains-mono hicolor-icon-theme python)
        if ! command -v wpctl >/dev/null 2>&1; then
            packages+=(pipewire wireplumber)
        fi
        if ! command -v matugen >/dev/null 2>&1; then
            packages+=(matugen)
        fi
        run_privileged pacman -S --needed "${packages[@]}"
        if ! command -v matugen >/dev/null 2>&1; then
            packages=(cargo base-devel)
            run_privileged pacman -S --needed "${packages[@]}"
            install_matugen
        fi
        ;;
    fedora)
        packages=(waybar SwayNotificationCenter fuzzel rofi swaybg fontawesome-fonts jetbrains-mono-fonts hicolor-icon-theme python3)
        if ! command -v wpctl >/dev/null 2>&1; then
            packages+=(pipewire-utils wireplumber)
        fi
        if ! command -v matugen >/dev/null 2>&1; then
            if dnf repoquery --available matugen 2>/dev/null | grep -q .; then
                packages+=(matugen)
            elif [[ "$(uname -m)" == x86_64 ]]; then
                packages+=(curl)
            else
                packages+=(cargo gcc make)
            fi
        fi
        run_privileged dnf install "${packages[@]}"
        install_matugen
        ;;
    opensuse*|opensuse-tumbleweed|opensuse-leap)
        packages=(waybar SwayNotificationCenter fuzzel rofi swaybg fontawesome-fonts jetbrains-mono-fonts hicolor-icon-theme python3)
        if ! command -v wpctl >/dev/null 2>&1; then
            packages+=(pipewire wireplumber)
        fi
        if ! command -v matugen >/dev/null 2>&1 && zypper search -x matugen 2>/dev/null | grep -q matugen; then
            packages+=(matugen)
        elif ! command -v matugen >/dev/null 2>&1; then
            if [[ "$(uname -m)" == x86_64 ]]; then
                packages+=(curl)
            else
                packages+=(cargo gcc make)
            fi
        fi
        run_privileged zypper install "${packages[@]}"
        install_matugen
        ;;
    *)
        echo "Automatic dependency installation is not configured for ${PRETTY_NAME:-$ID}. Install the packages listed by $CHECK manually." >&2
        exit 1
        ;;
esac

if ! "$CHECK"; then
    echo "Some commands are still missing. Check the messages above and install those packages manually." >&2
    exit 1
fi
