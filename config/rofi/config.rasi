configuration {
    modi: "drun";
    show-icons: true;
    drun-display-format: "{name}";
    icon-theme: "Papirus";
    display-drun: "";
    hover-select: true;
    matching: "fuzzy";
    case-sensitive: false;
    kb-row-up: "Up,Control+p";
    kb-row-down: "Down,Control+n";
    kb-row-left: "Left";
    kb-row-right: "Right";
}

@import "colors.rasi";

window {
    width: 760px;
}

mainbox {
    children: [ inputbar, listview ];
}

listview {
    columns: 4;
    lines: 1;
    fixed-height: true;
    fixed-columns: true;
    dynamic: false;
    scrollbar: true;
    cycle: false;
    flow: horizontal;
    spacing: 8px;
}

element {
    orientation: vertical;
    children: [ element-icon, element-text ];
    spacing: 8px;
    padding: 16px 10px;
}

element-icon {
    size: 48px;
    horizontal-align: 0.5;
}

element-text {
    horizontal-align: 0.5;
    vertical-align: 0.5;
    text-align: center;
    expand: true;
}
